Bootstrap: docker
From: rocker/r-ver:4.3.3

%labels
    Author SEA-AD network workflow
    RIMBANetCommit ebd5f4a6c31da22705622e71b6dc5f1eae195fdd
    RuntimeArchitecture linux-x86_64

%files
    external_tools/BayesianNetwork /opt/rimbanet-src

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        bash bc bcftools build-essential ca-certificates git gsl-bin \
        libgsl-dev perl plink2 python3 python3-pip python3-venv time zlib1g-dev
    rm -rf /var/lib/apt/lists/*

    Rscript --vanilla -e 'install.packages(c("BiocManager","data.table","digest","jsonlite","MatrixEQTL","yaml","cit"), repos="https://cloud.r-project.org"); BiocManager::install("edgeR", version="3.18", ask=FALSE, update=FALSE)'

    python3 -m venv /opt/rimbanet-venv
    /opt/rimbanet-venv/bin/pip install --no-cache-dir \
        "h5py>=3.11,<4" "networkx>=3.3,<4" "numpy>=1.26,<3" \
        "pandas>=2.1,<3" "PyYAML>=6,<7" "scipy>=1.11,<2"

    mkdir -p /opt/xerces-src /opt/xerces
    tar -xzf /opt/rimbanet-src/src/xerces-c-src_2_8_0.tar.gz \
        -C /opt/xerces-src --strip-components=1
    cd /opt/xerces-src/src/xercesc
    export XERCESCROOT=/opt/xerces-src
    ./runConfigure -p linux -c gcc -x g++ -r pthread -P /opt/xerces
    # Xerces-C++ 2.8's recursive makefiles are not parallel-safe. Building
    # serially prevents header-staging races under Minerva's modern toolchain.
    make
    make install

    cd /opt/rimbanet-src/src
    sed -i 's|^XMLROOT = .*|XMLROOT = /opt/xerces|' Makefile
    # Preserve the legacy source's original language mode. Its global
    # round(float) declaration conflicts with std::round in modern defaults.
    sed -i 's| -O -DLINUX -c| -O -std=gnu++98 -DLINUX -c|' Makefile
    make clean || true
    make -j"$(nproc)"
    install -m 0755 testBN /usr/local/bin/testBN
    install -m 0755 /opt/rimbanet-src/script/generateBIF \
        /usr/local/bin/generateBIF

%environment
    export LD_LIBRARY_PATH=/opt/xerces/lib:${LD_LIBRARY_PATH:-}
    export RIMBANET_ROOT=/opt/rimbanet-src
    export PATH=/opt/rimbanet-venv/bin:${PATH}

%test
    test "$(uname -m)" = "x86_64"
    test -x /usr/local/bin/testBN
    ldd /usr/local/bin/testBN | grep -q "libxerces-c"
    python -c "import h5py, networkx, numpy, pandas, scipy, yaml"
    # Ignore a bound project's .Rprofile so its renv library cannot mask the
    # packages installed in this image.
    Rscript --vanilla -e 'stopifnot(all(vapply(c("data.table","digest","edgeR","MatrixEQTL","yaml","cit"), requireNamespace, logical(1), quietly=TRUE)))'
